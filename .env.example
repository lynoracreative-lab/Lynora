# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/lynora"

# Secret used to sign admin session cookies (generate a long random string)
AUTH_SECRET=

# Local / first-run admin account created by `npm run db:seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public site URL used for sitemap, canonical URLs and Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:43127

# Media storage: "local" (default) or "cloudinary"
STORAGE_PROVIDER=local

# Cloudinary — only required when STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional later: email delivery for contact enquiries
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# EMAIL_FROM=Lynora <lynora.creative@gmail.com>
