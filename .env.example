# PostgreSQL connection string. Production uses the Supabase transaction pooler (port 6543).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/lynora"
# Direct connection for Prisma migrations. Locally this matches DATABASE_URL.
# Production uses the Supabase session pooler (port 5432).
DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/lynora"

# Secret used to sign admin session cookies (generate a long random string)
AUTH_SECRET=

# Local / first-run admin account created by `npm run db:seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public site URL used for sitemap, canonical URLs and Open Graph
NEXT_PUBLIC_SITE_URL=http://localhost:43127

# Media storage: "local" in development, "supabase" in production
STORAGE_PROVIDER=local

# Supabase — required when STORAGE_PROVIDER=supabase
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SECRET_KEY=
# Direct Postgres connection for Prisma migrations. Pooler URL stays in DATABASE_URL.
# DIRECT_URL=

# Cloudinary — only required when STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Contact form emails are saved in admin, then sent with Resend.
# Free Resend accounts can send from onboarding@resend.dev to the account inbox.
# After the lynora domain is verified, set EMAIL_FROM to a Lynora address.
# RESEND_API_KEY=
# EMAIL_FROM=Lynora <onboarding@resend.dev>
